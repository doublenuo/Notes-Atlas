# 复制为 .env 后填写；不要提交真实密钥。
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://blogs.lovetulin.cn
ALLOWED_ORIGINS=https://blogs.lovetulin.cn,https://comments.lovetulin.cn,https://www.lovetulin.cn,http://localhost:5173,http://127.0.0.1:5173

# 32 字节以上的随机字符串：openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=180
SESSION_REFRESH_HOURS=24
COOKIE_DOMAIN=.lovetulin.cn
COOKIE_SECURE=true

DATABASE_PATH=./data/auth.db

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://blogs.lovetulin.cn/api/auth/github/callback

# 阿里云邮件推送 DirectMail（SMTP）
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_DRY_RUN=false
MAIL_FROM=noreply@lovetulin.cn

# 管理员邮箱，逗号分隔；管理员也必须走统一登录，仅用于标记身份
ADMIN_EMAILS=

TWIKOO_UPSTREAM=http://127.0.0.1:8080
TWIKOO_TIMEOUT_MS=30000
MAX_BODY_MB=20
