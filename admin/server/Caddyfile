blogs.lovetulin.cn {
	# Admin 后台管理系统（优先匹配 /admin 路径）
	handle /admin/* {
		reverse_proxy 172.18.0.1:8477 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# /admin（不带尾斜杠）也要能用。handle /admin/* 只匹配 /admin/… 下的路径，
	# 而磁盘上并没有名为 admin 的文件 —— 页面路由去掉 SPA 兜底后，这里会返回
	# 404，浏览器直接访问 blogs.lovetulin.cn/admin 就是白屏。
	redir /admin /admin/ 308

	root * /opt/blogs
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	# 静态资源：只回真实文件，缺失时给真 404。
	# 资源请求绝不能落进下面的 SPA 回退——否则浏览器会把 index.html 当脚本/
	# 样式执行，报 "Unexpected token '<'" 之类与真实原因无关的误导性错误。
	# 扩展名用白名单而非通用 \.[a-zA-Z0-9]{2,5}$：站内存在
	# 02.学习笔记/04.agent、04.LLM、12.ROS 这类以点号结尾的目录名，
	# 通用正则会把它们误判成资源而不予回退。
	@asset path_regexp asset \.(?:js|mjs|css|map|json|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|otf|eot|mp4|webm|mp3|wav|ogg|pdf|txt|xml|zip|wasm)$
	handle @asset {
		try_files {path}
		file_server
	}

	# 页面路由，三级回退：
	#   {path}       真实文件
	#   {path}.html  VitePress cleanUrls
	#   {path}/      目录 + index.html
	#
	# 这里**没有** /index.html 兜底。站点已全量改用 permalink 路由（由
	# docs/.vitepress/permalinks.ts 生成 rewrites 实现），每篇文章都有对应的
	# 真实 HTML 产物，不需要 SPA 外壳兜底。曾经加过 /index.html 是为了救
	# permalink 硬刷新 404，但那样会让所有失效链接（包括改名前的中文路径）
	# 都返回 200 + 应用外壳，掩盖问题，也让搜索引擎收录到软 404。
	# 现在找不到就是真 404，由 file_server 返回。
	handle {
		try_files {path} {path}.html {path}/
		file_server
	}
}
