# Admin 认证
ADMIN_USER=admin
ADMIN_PASS_HASH=<用 hashPassword 生成的 bcrypt 串>
TOKEN_SECRET=<openssl rand -hex 32 的输出>

# 站点目录
SITE_DIR=/srv/site

# 服务器配置
HOST=0.0.0.0
PORT=8477
COOKIE_SECURE=1

# 构建配置
# BUILD_AUTO=0 → 关闭容器内 watcher 自动构建(宿主机内存不足,vitepress 全量构建会 OOM);
# 面板保存后提交并 push,站点发布由 GitHub Actions(deploy.yml)在 CI 上构建后 scp 到 /opt/blogs。
BUILD_AUTO=1
BUILD_DEBOUNCE_MS=5000
BUILD_TIMEOUT_MS=600000

# Docker 发布配置
CADDY_CONTAINER=caddy
DOCKER_SOCKET=/var/run/docker.sock
PUBLISH_PATH=/opt/blogs
